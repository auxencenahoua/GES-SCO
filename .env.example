# Server-side only. Never prefix secrets with NEXT_PUBLIC_.
# Pooled connection for app traffic. Keep this server-side.
DATABASE_URL=
# Direct, non-pooled connection used exclusively by migration tooling.
DATABASE_URL_UNPOOLED=
# Generate at least 32 high-entropy bytes. Never commit the resulting value.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
